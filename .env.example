# --- Core ---
DATABASE_URL=postgresql+asyncpg://nexus:nexus@db:5432/nexus
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-32-chars-minimum-please
TOKEN_FERNET_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ANALYZER_VERSION=v0.1.0

# --- GitHub OAuth / App (get from GitHub; required Phase 1+) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:3000/api/auth/callback

# --- LLM (required Phase 2+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=120

# --- Sandbox ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_S=600
